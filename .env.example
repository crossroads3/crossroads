# Supabase config (server-side).
# Copy this file to `.env.local` for local development and fill in the values.
#
# How to get the values (Supabase Dashboard -> Project -> Settings -> API):
#   NEXT_PUBLIC_SUPABASE_URL = your project URL, e.g. https://xxxx.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY = the `service_role` secret key (NEVER expose this in the browser)

NEXT_PUBLIC_SUPABASE_URL=https://phjxelwnmarabidhjwco.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For deployment, set these as environment variables on Vercel / Netlify
# (NOT in .env files committed to git).
